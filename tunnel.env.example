# One file per tunnel (e.g. tunnel-server1.env). Only the first four lines are required.
SSH_HOST=server1.example.com
SSH_USER=user1
# listen_port:target_host:target_port, comma-separated; target_host as seen from the SSH server
FORWARDS=3306:127.0.0.1:3306

# Optional (defaults shown)
SSH_PORT=22
SSH_KEY_FILE=/ssh/id_ed25519
SSH_KNOWN_HOSTS_FILE=/ssh/known_hosts
# true when every target speaks first (MySQL does): the check then proves a new SSH channel works end to end
HEALTH_READ_BANNER=true
SSH_ALIVE_INTERVAL=15
SSH_ALIVE_COUNT=3
# 0 disables the watchdog
WATCHDOG_INTERVAL=30
WATCHDOG_FAILURES=3
# SSH_EXTRA_OPTS=-o KexAlgorithms=...
